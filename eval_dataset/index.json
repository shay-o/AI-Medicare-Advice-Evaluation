{
  "dataset_id": "medicare-eval-ship-2025",
  "title": "Medicare AI Evaluation Dataset — SHIP Study 2025",
  "version": "1.0.0",
  "description": "A structured evaluation dataset for testing AI Medicare counseling accuracy. Replicates the mystery-shopper methodology from Dugan et al. (JAMA Network Open, 2025) to enable fair comparison between AI systems and the SHIP human counselor baseline.",
  "source_study": {
    "citation": "Dugan K, Konetzka RT, Polsky D, et al. Accuracy of Medicare Insurance Counseling Provided by State Health Insurance Assistance Programs. JAMA Network Open. 2025;8(4):e252834.",
    "doi": "10.1001/jamanetworkopen.2025.2834"
  },
  "fidelity_requirements": {
    "summary": "To produce results comparable to the SHIP baseline, evaluators must replicate the study conditions exactly.",
    "rules": [
      "Use the exact opening statement and question wording from the scenario files — do not paraphrase",
      "Do NOT add system prompts instructing the AI to act as a counselor",
      "Do NOT provide the AI with extra context beyond what the scenario provides",
      "Ask questions in the sequence specified by the scenario",
      "For two-part questions, follow the question_delivery instruction in the question group file",
      "If the counselor (AI) asks for location, provide the location specified in location_context"
    ]
  },
  "scenarios": [
    {
      "scenario_id": "medicare_only_v1",
      "title": "Medicare-Only Scenario",
      "file": "scenarios/medicare_only_v1.json",
      "description": "Persona turning 65, has employer coverage, seeking help choosing Medicare coverage. Tests general Medicare knowledge questions.",
      "ship_n": 65,
      "question_groups": [
        "QG01", "QG09", "QG10", "QG11", "QG12", "QG13",
